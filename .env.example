# MUET Point Tracker Configuration
# Server Port
PORT=3001
VITE_PORT=3001

# JWT Secret for Session & Server Token Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Active Database Engine: "sqlite" (Default) or "supabase"
DB_ENGINE=sqlite

# SQLite Persistent Volume Path (Defaults to ./muet_tracker.sqlite in current directory)
# For Railway deployment with a persistent volume mounted at /data, set:
# DATA_DIR=/data
# DB_PATH=/data/muet_tracker.sqlite

# Optional: Supabase Credentials (leave empty to use local SQLite database)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
